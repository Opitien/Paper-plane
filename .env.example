# Paper Plane — environment variables
# Copy to .env.local if you need to change anything. Nothing here is required:
# the game runs with no configuration and has no secrets.

# --- Build ------------------------------------------------------------------
# Sub-path the site is served from. Leave empty for the root ("/").
# GitHub Pages project sites need "/<repo-name>/". Read at build time only.
BASE_PATH=

# Absolute origin used in the social-card tags (og:image, og:url), no trailing
# slash, e.g. https://paper-plane.vercel.app. On Vercel this is filled in
# automatically from the deployment; set it only for other hosts.
SITE_URL=
